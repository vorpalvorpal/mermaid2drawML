%%{init: {
  'fontFamily': 'Myriad Pro',
  'flowchart': {'defaultRenderer': 'elk'},
  'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF'},
  'themeVariables': {
    'fontFamily': 'Myriad Pro',
    'fontSize': '10px'
  }
}}%%
flowchart LR
    subgraph ENV["Monitoring"]
        Contractors(["Contractors"]):::green
        EnvSiteStaff(["Staff"]):::green
        WeatherDB@{ shape: fr-rect, label: "Weather<br>station"}
        EnvDB[("Enviro<br>monitoring<br>database")]:::green
        EnvChecklist@{ shape: docs, label: "Monthly/quarterly<br>checklists"}
        Scada@{ shape: fr-rect, label: "SCADA"}
        EnvSiteStaff --> EnvDB
        Contractors --> EnvDB
        EnvSiteStaff --> EnvChecklist
    end

    subgraph GATE["Gatehouse"]
        GateSiteStaff(["Weighbridge<br>operators"]):::purple
        TipsiteDB[("Tipsite\ndatabase")]:::purple
        GateSiteStaff --> TipsiteDB
    end

    subgraph OPS["Operational"]
        OpsChecklist@{ shape: docs, label: "Weekly/Monthly<br>checklists"}
        DailyLog@{ shape: doc, label: "Daily Log"}
        OpsSiteStaff(["Operators"]):::red
        OpsSiteStaff --> DailyLog
        OpsSiteStaff --> OpsChecklist
    end

    subgraph MANG["Governance"]
        AutoReports@{ shape: docs, label: "KPI<br>Reports"}
        Management(["Management"]):::blue
        GRSG(["GRSG"]):::blue
        ARIC(["ARIC"]):::blue
        SOPs@{ shape: docs, label: "LEMP, SOPs"}
        Management --> SOPs
        Management --> GRSG
        Management --> ARIC
    end

    subgraph AUD["Audit"]
        Auditors(["Auditors"]):::orange
        AuditReport@{ shape: doc, label: "Audit<br>Report"}
        Auditors --> AuditReport
    end

    subgraph REG["External"]
        EPA(["EPA"]):::bark
        SW(["Sydney Water"]):::bark
        Council(["Council"]):::bark
        Government(["Government"]):::bark
        Regs@{ shape: docs, label: "Regulations, licenses,<br>consents, standards"}
        Web@{ shape: win-pane, label: "Public<br>website"}
        Community(["Community"]):::bark
        EnvDB --> Web
        WeatherDB --> Web
        Web --> Community
        Government --> Regs
        EPA --> Regs
        SW --> Regs
        Council --> Regs
    end

    EnvDB --> EPA
    EnvDB --> SW
    TipsiteDB --> EPA
    Regs --> SOPs

    EnvDB --> AutoReports
    Scada --> AutoReports
    EnvChecklist --> AutoReports
    OpsChecklist --> AutoReports
    DailyLog --> Auditors
    OpsChecklist --> Auditors
    DailyLog --> AutoReports
    WeatherDB --> AutoReports
    TipsiteDB --> AutoReports
    AuditReport --> Management
    AutoReports --> Management
    EnvChecklist --> Auditors
    AuditReport --> ARIC
    SOPs --> Auditors
    SOPs --> OpsSiteStaff
    SOPs --> EnvSiteStaff
    SOPs --> Contractors
    SOPs --> GateSiteStaff

    classDef green  fill:none,stroke:#5A8263,color:#5A8263
    classDef red    fill:none,stroke:#700017,color:#700017
    classDef purple fill:none,stroke:#9186BF,color:#9186BF
    classDef orange fill:none,stroke:#cc6600,color:#cc6600
    classDef blue   fill:none,stroke:#0066cc,color:#0066cc
    classDef bark   fill:none,stroke:#5E504E,color:#5E504E

    classDef GREEN  fill:none,stroke:#5A8263,color:#5A8263,stroke-width:4px,font-size:16px,font-weight:bold
    classDef RED    fill:none,stroke:#700017,color:#700017,stroke-width:4px,font-size:16px,font-weight:bold
    classDef PURPLE fill:none,stroke:#9186BF,color:#9186BF,stroke-width:4px,font-size:16px,font-weight:bold
    classDef ORANGE fill:none,stroke:#cc6600,color:#cc6600,stroke-width:4px,font-size:16px,font-weight:bold
    classDef BLUE   fill:none,stroke:#0066cc,color:#0066cc,stroke-width:4px,font-size:16px,font-weight:bold
    classDef BARK   fill:none,stroke:#5E504E,color:#5E504E,stroke-width:4px,font-size:16px,font-weight:bold

    class WeatherDB,EnvChecklist,Scada green
    class OpsChecklist,DailyLog red
    class AutoReports,SOPs blue
    class AuditReport orange
    class Regs,Web bark

    class ENV GREEN
    class GATE PURPLE
    class OPS RED
    class MANG BLUE
    class AUD ORANGE
    class REG BARK

    linkStyle 0,1,2,10,11,17,18,21,22,23,28,32  stroke:#3d7a56,stroke-width:2px
    linkStyle 4,5,24,25,26,27                    stroke:#8B3344,stroke-width:2px
    linkStyle 3,19,29                            stroke:#7d7aa8,stroke-width:2px
    linkStyle 9,30,33                            stroke:#a07040,stroke-width:2px
    linkStyle 6,7,8,31,34,35,36,37,38           stroke:#4d80a8,stroke-width:2px
    linkStyle 12,13,14,15,16,20                 stroke:#7a6a67,stroke-width:2px
